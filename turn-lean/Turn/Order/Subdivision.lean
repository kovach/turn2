import Mathlib

/-!
# Moment orders generated by subdivision

Turn's moment order is never given; rule firings build it. The only edges
ever asserted come from `+`/`~` emits (expand.ts `decomposeEmit`): a fresh
moment `v` with `XL < v < XR`, where `XL ≤ XR` already holds (the
running-anchor invariant). An episode does this twice (`l` inside the anchor,
then `r` inside `[l, XR]`). So every reachable moment graph is obtained from
`bot → top` by repeatedly *subdividing* a path `a ⇝ b` with a fresh vertex.

`notes/moment-insertion.md` proves informally that the path relation of such a
graph is a lattice. This file states that theorem and the structural lemmas its
proof uses, for finite graphs given extensionally.

Two flavours of insertion are distinguished:

* `Subdiv` requires `a ≠ b` (a *strict* subdivision). This is the semantics
  recommended by `discussions/turn-temporal-logic.md` §5.3.
* `SubdivWeak` allows `a = b`, which is what the implementation does today
  (an emit at a point anchor asserts `a < v < a`, i.e. a cycle).
-/

namespace Turn.Order

variable {α : Type*}

/-- A moment graph: a vertex set and a directed edge relation. -/
structure Graph (α : Type*) where
  V : Set α
  E : α → α → Prop

namespace Graph

/-- The (reflexive) path relation: the moment order `≤` the graph presents. -/
def reach (G : Graph α) : α → α → Prop := Relation.ReflTransGen G.E

/-- Insert a fresh vertex `v` on the path `a ⇝ b`: edges `a → v` and `v → b`. -/
def subdivide (G : Graph α) (a b v : α) : Graph α where
  V := insert v G.V
  E x y := G.E x y ∨ (x = a ∧ y = v) ∨ (x = v ∧ y = b)

/-- `z` is the least upper bound of `x, y` among the graph's vertices. -/
def IsLUB (G : Graph α) (x y z : α) : Prop :=
  z ∈ G.V ∧ G.reach x z ∧ G.reach y z ∧
    ∀ w ∈ G.V, G.reach x w → G.reach y w → G.reach z w

/-- `z` is the greatest lower bound of `x, y` among the graph's vertices. -/
def IsGLB (G : Graph α) (x y z : α) : Prop :=
  z ∈ G.V ∧ G.reach z x ∧ G.reach z y ∧
    ∀ w ∈ G.V, G.reach w x → G.reach w y → G.reach w z

end Graph

/-- The two-element graph `bot → top`, where every derivation starts. -/
def base (bot top : α) : Graph α where
  V := {bot, top}
  E x y := x = bot ∧ y = top

/-- Graphs generated from `bot → top` by **strict** subdivisions. -/
inductive Subdiv (bot top : α) : Graph α → Prop
  | base : bot ≠ top → Subdiv bot top (base bot top)
  | subdivide {G : Graph α} {a b v : α} :
      Subdiv bot top G → a ∈ G.V → b ∈ G.V → G.reach a b → a ≠ b → v ∉ G.V →
      Subdiv bot top (G.subdivide a b v)

/-- Graphs generated by possibly-degenerate subdivisions (`a = b` allowed):
the order the implementation's `AssertLt` builds. -/
inductive SubdivWeak (bot top : α) : Graph α → Prop
  | base : bot ≠ top → SubdivWeak bot top (base bot top)
  | subdivide {G : Graph α} {a b v : α} :
      SubdivWeak bot top G → a ∈ G.V → b ∈ G.V → G.reach a b → v ∉ G.V →
      SubdivWeak bot top (G.subdivide a b v)

namespace Subdiv

variable {bot top : α} {G : Graph α}

theorem toWeak (h : Subdiv bot top G) : SubdivWeak bot top G := by
  sorry

theorem finite (h : Subdiv bot top G) : G.V.Finite := by
  sorry

theorem edge_mem (h : Subdiv bot top G) {x y : α} (e : G.E x y) : x ∈ G.V ∧ y ∈ G.V := by
  sorry

theorem bot_reach (h : Subdiv bot top G) {x : α} (hx : x ∈ G.V) : G.reach bot x := by
  sorry

theorem reach_top (h : Subdiv bot top G) {x : α} (hx : x ∈ G.V) : G.reach x top := by
  sorry

/-- **Structural lemma, down-set.** After inserting `v` on `a ⇝ b`, the things
below `v` are exactly the things below `a`, plus `v`. -/
theorem reach_new_iff_left (h : Subdiv bot top G) {a b v x : α}
    (ha : a ∈ G.V) (hv : v ∉ G.V) (hx : x ∈ G.V) :
    (G.subdivide a b v).reach x v ↔ G.reach x a := by
  sorry

/-- **Structural lemma, up-set.** The things above `v` are the things above `b`. -/
theorem reach_new_iff_right (h : Subdiv bot top G) {a b v x : α}
    (hb : b ∈ G.V) (hv : v ∉ G.V) (hx : x ∈ G.V) :
    (G.subdivide a b v).reach v x ↔ G.reach b x := by
  sorry

/-- Insertion is conservative: the order among old vertices does not change.
This is what makes resolved moments stay resolved in the moment walk. -/
theorem reach_old_iff (h : Subdiv bot top G) {a b v x y : α}
    (hab : G.reach a b) (hv : v ∉ G.V) (hx : x ∈ G.V) (hy : y ∈ G.V) :
    (G.subdivide a b v).reach x y ↔ G.reach x y := by
  sorry

/-- The path relation of a strict subdivision graph is antisymmetric. -/
theorem antisymm (h : Subdiv bot top G) {x y : α} (hx : x ∈ G.V) (hy : y ∈ G.V)
    (hxy : G.reach x y) (hyx : G.reach y x) : x = y := by
  sorry

/-- **Lattice theorem** (`notes/moment-insertion.md`): every pair of vertices has
a least upper bound. -/
theorem exists_lub (h : Subdiv bot top G) {x y : α} (hx : x ∈ G.V) (hy : y ∈ G.V) :
    ∃ z, G.IsLUB x y z := by
  sorry

/-- Dual of `exists_lub`. -/
theorem exists_glb (h : Subdiv bot top G) {x y : α} (hx : x ∈ G.V) (hy : y ∈ G.V) :
    ∃ z, G.IsGLB x y z := by
  sorry

/-- Old least upper bounds survive insertions. Needed to pass from finite
stages to the (possibly infinite) chase. -/
theorem lub_stable (h : Subdiv bot top G) {a b v x y z : α}
    (hab : G.reach a b) (hv : v ∉ G.V) (hz : G.IsLUB x y z) :
    (G.subdivide a b v).IsLUB x y z := by
  sorry

/-- Packaged form: the vertices carry a lattice whose `≤` is reachability. -/
theorem lattice (h : Subdiv bot top G) :
    ∃ L : Lattice G.V, letI := L; ∀ x y : G.V, x ≤ y ↔ G.reach x y := by
  sorry

/-- **Siblings join at the end of their anchor.** Two fresh moments minted
independently inside the same anchor `[a, b]` have least upper bound `b`.
This is the tutorial's "constructive overlap" phenomenon: concurrent
sub-events of an episode become jointly observable exactly at its end. -/
theorem sibling_lub (h : Subdiv bot top G) {a b v w : α}
    (ha : a ∈ G.V) (hb : b ∈ G.V) (hab : G.reach a b) (hne : a ≠ b)
    (hv : v ∉ G.V) (hw : w ∉ insert v G.V) (hvw : v ≠ w) :
    ((G.subdivide a b v).subdivide a b w).IsLUB v w b := by
  sorry

end Subdiv

/-- A degenerate insertion (`a = b`) breaks antisymmetry: this is the cycle the
implementation asserts for an emit at a point anchor (`a, (+p); +q`). -/
theorem SubdivWeak.point_cycle {bot top a v : α} {G : Graph α}
    (h : SubdivWeak bot top G) (ha : a ∈ G.V) (hv : v ∉ G.V) :
    (G.subdivide a a v).reach a v ∧ (G.subdivide a a v).reach v a ∧ a ≠ v := by
  sorry

end Turn.Order
