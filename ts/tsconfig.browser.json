{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },
  "include": ["src/v1/web.ts", "src/web-v2.ts", "src/pres/main.ts"],
  "exclude": ["dist"]
}
